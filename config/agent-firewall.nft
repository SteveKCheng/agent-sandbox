table inet agent_sandbox_filter {

    set self4 {
        type ipv4_addr
        elements = { 169.254.0.2 }
    }

    set self6 {
        type ipv6_addr
        elements = { fd00::2 }
    }

    set gateway4 {
        type ipv4_addr
        elements = { 169.254.0.1 }
    }

    set gateway6 {
        type ipv6_addr
        elements = { fd00::1 }
    }

    chain output {
        type filter hook output priority 0

        # Allow internal loopback, for running local servers
        oif "lo" accept

        # Allow talking to self
        oif "sandbox_tap" ip  daddr @self4 accept
        oif "sandbox_tap" ip6 daddr @self6 accept

        # Allow DNS queries to pasta's virtual gateway
        oif "sandbox_tap" ip  daddr @gateway4 meta l4proto { tcp, udp } th dport 53 accept
        oif "sandbox_tap" ip6 daddr @gateway6 meta l4proto { tcp, udp } th dport 53 accept

        # Allow connections ONLY to host's HTTP(S) filtering proxy
        oif "sandbox_tap" ip  daddr @gateway4 tcp dport 8080 accept
        oif "sandbox_tap" ip6 daddr @gateway6 tcp dport 8080 accept

        # Allow ICMP to gateway
        oif "sandbox_tap" ip  daddr @gateway4 ip protocol icmp accept
        oif "sandbox_tap" ip6 daddr @gateway6 meta l4proto ipv6-icmp accept

        # Allow established/related incoming responses
        ct state established,related accept

        reject
    }

    chain input {
        type filter hook input priority 0; policy accept;

        ct state established,related accept

        # Block all incoming connections.
        #
        # nft, as a packet filter, cannot block the sandbox from creating a listening socket, 
        # but this rule makes any port completely unreachable from outside the sandbox.
        #
        # Note this rule does not prevent log-ins into a sshd running inside the sandbox,
        # if sshd is set to run in inetd mode, with the host listening and accepting sockets
        # on behalf of sshd.  If the sandbox is running an independently listening sshd
        # then of course that port must be excepted here.
        #
        # If pasta is set to not do port forwarding into the sandbox, then the sandbox's
        # ports cannot be reached in the first place, but still it is better to have the
        # firewalling rules in one place rather than relying on pasta's configuration.
        iifname "sandbox_tap" reject
    }
    
}
